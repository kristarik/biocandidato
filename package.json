{
  "name": "biocandidato",
  "version": "0.1.0",
  "private": true,
  "description": "Voto.IO - CRM Eleitoral (MVP)",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:check": "node scripts/db-check.js",
