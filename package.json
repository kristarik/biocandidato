{
  "name": "biocandidato",
  "version": "0.1.0",
  "private": true,
  "description": "Candidato Online - CRM Eleitoral (MVP)",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "node scripts/new-migration.js",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "candidato:novo": "node scripts/novo-candidato.js",
    "candidato:exemplo": "node scripts/conteudo-exemplo.js",
    "postinstall": "prisma generate",
    "candidato:senha": "node scripts/redefinir-senha.js",
    "candidato:apoiadores": "node scripts/apoiadores-exemplo.js",
    "master:novo": "node scripts/novo-master.js",
    "sms:teste": "node scripts/testar-sms.js",
    "candidato:montar": "node scripts/montar-candidato.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
