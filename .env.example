# Copie para .env e preencha com os dados reais do hPanel.
# O .env NUNCA vai para o Git.

# Bancos de Dados > Gerenciamento de Bancos MySQL
DB_HOST=srv0000.hstgr.io
DB_PORT=3306
DB_USER=u000000000_usuario
DB_PASSWORD=
DB_NAME=u000000000_banco

# Token para liberar a rota /db-check em producao.
# Gere um valor aleatorio longo. Sem ele, a rota fica desativada.
DEBUG_TOKEN=

# A Hostinger injeta PORT automaticamente. Localmente usa 3000.
PORT=3000

# Assina as sessoes do painel. Minimo 32 caracteres, aleatorio.
# Sem isso o painel nao sobe - e proposital: segredo fraco ou previsivel
# permitiria forjar um cookie e entrar como qualquer candidato.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Em producao, marca o cookie de sessao como "secure" (so trafega por HTTPS).
NODE_ENV=production

# Com "console", o codigo de confirmacao volta na resposta da API para dar
# para testar o cadastro sem receber SMS de verdade. NUNCA defina isso em
# producao: qualquer pessoa conseguiria confirmar o cadastro de qualquer numero.
SMS_MODO=console

# Provedor de envio: "console" (so registra no log) ou "twilio".
# Sem credencial valida, cai para console automaticamente.
SMS_PROVEDOR=console

# Twilio: Console > Account Info. O FROM e o numero comprado, em E.164.
# ATENCAO na conta de teste: so entrega para numeros verificados no painel da
# Twilio, e a mensagem chega com um aviso de trial na frente.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000
