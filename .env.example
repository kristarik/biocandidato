# Copie para .env e preencha com os dados reais do hPanel.
# O .env NUNCA vai para o Git.

# Bancos de Dados > Gerenciamento de Bancos MySQL
DB_HOST=srv0000.hstgr.io
DB_PORT=3306
DB_USER=u000000000_usuario
DB_PASSWORD=
DB_NAME=u000000000_banco

# Token para liberar a rota /db-check em producao.
# Gere um valor aleatorio longo. Sem ele, a rota fica desativada.
DEBUG_TOKEN=

# A Hostinger injeta PORT automaticamente. Localmente usa 3000.
PORT=3000

# Nenhum gateway de SMS esta integrado ainda. Com "console", o codigo de
# confirmacao volta na resposta da API para dar para testar o cadastro sem
# receber SMS de verdade. NUNCA defina isso em producao: qualquer pessoa
# conseguiria confirmar o cadastro de qualquer numero.
SMS_MODO=console
